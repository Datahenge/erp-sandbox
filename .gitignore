# ─── Secrets and generated configuration ─────────────────────────────────
# config.toml holds real values, including PATs and passwords.
# Only config.sample.toml is committed.
config.toml
.env

# Machine-local state and secrets for the environment rooted here
# (decision #27). .erp-sandbox/ is also the marker that makes a directory an
# environment, which is why the tool looks for the directory rather than a file.
/.erp-sandbox/

# Generated by `erp-sandbox render` — never hand-edited, never committed.
# docker-compose.yml and conf/ join this list under decision #27: the canonical
# copies now ship inside the package, and render materializes them here.
/compose.podman.yml
/compose.docker.yml
/docker-compose.yml
/conf/
/bench/sites/common_site_config.json
/bench/sites/apps.txt
/bench/Procfile

# The bench image's build context, materialized into the environment because
# docker-compose.yml names it as a path relative to itself. The canonical copy
# is erp_sandbox/assets/images/bench/ and is committed; this one is output. The
# leading slash is what keeps erp_sandbox/assets/images/ tracked.
/images/

# ─── Client-specific material: never committed ───────────────────────────
# local/ holds real client values — the reference-environment record and a
# config.toml with real repo URLs. Nothing published may carry them.
/local/

# ─── Build state and runtime data ────────────────────────────────────────
# Leading slashes matter. An unanchored "bench/" matches at ANY depth, which
# silently swallowed images/bench/ -- the bench image's own Dockerfile -- and a
# gitignored file gives no warning that it is being skipped.
.build_state
/bench/
/data/
*.log

# ─── Python packaging artifacts ──────────────────────────────────────────
# setuptools writes these into the source tree on every `pipx install .` or
# `uv tool install .`, which is a normal part of working on the tool. They were
# untracked but not ignored, which is the dangerous combination: `git add -A`
# would have swept 36 files of build output into a commit.
/build/
/dist/
*.egg-info/
.eggs/

# ─── Editor / OS noise ───────────────────────────────────────────────────
.vscode/
*.swp
.DS_Store
__pycache__/
*.py[cod]

# The maintainers' private notes: a separate private repository checked out
# here (decision #53). Never committed to this one.
/internal/
