@@{header}
#
# Read by the container engine's compose front end.  Every value here came from
# config.toml; change it there and re-render.
#
# This file contains resolved passwords and is written mode 0600.  It is
# gitignored.  It carries no git credential -- the PAT is used host-side only,
# by erp-sandbox fetch, and never reaches a container or an image layer.

# --- identity ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=@@{project_name}
PROJECT_NAME=@@{project_name}
SITE_NAME=@@{site_name}
TZ=@@{timezone}

# --- detected from the host, never configured (decision #15) ----------------
HOST_UID=@@{host_uid}
HOST_GID=@@{host_gid}

# --- published to the host (decision #16) -----------------------------------
# BIND_HTTP is the address nginx's port is published on (decision #46).
BIND_HTTP=@@{bind_http}
PORT_HTTP=@@{port_http}
PORT_MARIADB=@@{port_mariadb}
@@{debug_env}
# --- container network only -------------------------------------------------
INTERNAL_WEB_PORT=@@{internal_web}
INTERNAL_SOCKETIO_PORT=@@{internal_socketio}
INTERNAL_FILE_WATCHER_PORT=@@{internal_file_watcher}
INTERNAL_MARIADB_PORT=@@{internal_mariadb}
INTERNAL_REDIS_PORT=@@{internal_redis}

# --- images and toolchain versions ------------------------------------------
BASE_IMAGE=@@{base_image}
PYTHON_VERSION=@@{python_version}
NODE_VERSION=@@{node_version}
YARN_VERSION=@@{yarn_version}
# Extra apt packages an app needs in order to build (config.toml [stack]).
EXTRA_PACKAGES=@@{extra_packages}
WKHTMLTOPDF_RELEASE=@@{wkhtmltopdf_release}
BENCH_VERSION=@@{bench_version}
MARIADB_IMAGE=@@{mariadb_image}
REDIS_IMAGE=@@{redis_image}
NGINX_IMAGE=@@{nginx_image}

# --- resolved secrets -------------------------------------------------------
DB_ROOT_PASSWORD=@@{db_root_password}
ADMIN_PASSWORD=@@{admin_password}
