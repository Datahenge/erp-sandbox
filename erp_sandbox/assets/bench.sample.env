# ═══ bench.env ════════════════════════════════════════════════════════════
#
# Runtime secrets for the bench container, and nothing else: credentials the
# *apps* read from their environment at run time -- an API key, an object
# store's access key pair. Every bench process sees them: web, workers, the
# scheduler, `bench console`.
#
# To use it:
#
#   1. cp .erp-sandbox/bench.sample.env .erp-sandbox/bench.env
#   2. chmod 600 .erp-sandbox/bench.env
#   3. Fill in the variables your apps read, and delete the rest.
#   4. In config.toml:
#        [bench]
#        env_file = ".erp-sandbox/bench.env"
#   5. erp-sandbox render
#   6. erp-sandbox up --recreate bench
#
# A change to this file takes effect only when the container is recreated --
# step 6 again. `erp-sandbox restart` keeps the old values.
#
# NOT secrets.env. That file holds the build and host secrets -- the PAT, the
# MariaDB root password, the admin password -- and none of them belongs in the
# container. preflight fails if this file uses any name config.toml reads its
# own secrets from.
#
# preflight also fails if this file is group- or world-readable, or if git
# would commit it. Anyone who can run docker or podman as you can read these
# values with `inspect`; that is the same access as a shell in the container.
#
# Format: KEY=value, one per line. Avoid '$' in a value: the compose front end
# may expand it, and preflight warns when it sees one.

# An API key an app reads with os.environ:
# EXAMPLE_API_KEY=

# A pair for an S3-compatible object store:
# EXAMPLE_S3_ACCESS_KEY_ID=
# EXAMPLE_S3_SECRET_ACCESS_KEY=
