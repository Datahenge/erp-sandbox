# ═══ secrets.env ══════════════════════════════════════════════════════════
#
#   cp secrets.sample.env secrets.env
#   chmod 600 secrets.env
#   $EDITOR secrets.env
#
# An alternative to exporting these in your shell. Every "env:NAME" in
# config.toml is looked up here when NAME is not already exported.
#
#   the shell wins.  export NAME=... overrides this file for one run without
#   editing it. preflight prints which source answered for each secret, so an
#   override is never silent.
#
# This is NOT .env. render.py generates .env for the container engine's
# compose front end and overwrites it on every render; anything you put there
# would be destroyed. config.toml rejects '.env' as a secrets file for that
# reason.
#
# secrets.env is gitignored, and preflight fails if git would commit the file
# it is reading secrets from. It also fails if the file is group- or
# world-readable, so keep it at mode 600.
#
# To keep secrets out of the repository altogether, put this file somewhere
# else and point config.toml at it:
#
#   [secrets]
#   file = "~/.config/erp-sandbox/acme.env"
#
# Format: KEY=value, one per line. Not a shell -- $OTHER is not expanded and
# an inline # is not a comment, because both are legal in a password. A
# leading "export" is tolerated, so this file can also be sourced. Surrounding
# quotes are stripped if they match.

# Read access to the private app repositories. Nothing more than read.
GIT_PAT=

# MariaDB root password. The container is created with it on first start.
DB_ROOT_PASSWORD=

# The Administrator password for the Frappe site.
ADMIN_PASSWORD=

# Only needed when [database].seed restores a dump, and then it must be the
# key that matches THAT dump. See config.sample.toml.
# ENCRYPTION_KEY=
